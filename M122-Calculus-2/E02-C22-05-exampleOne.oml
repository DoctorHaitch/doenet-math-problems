<!--
  Author: Kris Hollingsworth
  Class: Math122-Calculus 2
  Date: 6/14/26
  File: E02-C22-05-exampleOne.oml
  Description:
    Fully worked example of Trig Substitution
  Raw Link: https://raw.githubusercontent.com/DoctorHaitch/doenet-math-problems/main/M122-Calculus-2/E02-C22-05-exampleOne.oml
-->
<cascade>
  <div>
    <mathInput name="var"><label>Using the dummy variable</label></mathInput>, <!--  prefillLatex="t" -->
    <answer><mathInput><label>we introduce the substitution <m>x=</m></label></mathInput><m>3\sin $var</m></answer>.
    <answer simplifyOnCompare="none" symbolicEquality="true">
      <mathInput><label>Then <m>dx=</m></label></mathInput>
      <award><math format="latex">3 \cos t d$var</math></award>
      <award><math format="latex">\cos t 3 d$var</math></award>
    </answer>
  </div>
  <div>
    <br />
    <answer>
    <mathInput><label>Then the antiderivative in terms of $var is</label></mathInput>
    <award><math format="latex">-\cot $var - $var + C</math></award>
    </answer>.</div>
  <div>
    <graph size="small" displayXAxisTickLabels="false" displayYAxisTickLabels="false" xMin="-0.5" xMax="2.5" yMin="-0.5" yMax="2.5" showNavigation="false">
      <shortDescription>asdf</shortDescription>
      <rectangle vertices="(2,0) (14.5/8, 1.5/8)" />
      <triangle vertices="(0,0) (2, 0) (2,2)"></triangle>
      <curve 
        name="angleArc" 
        variable="t" parMin="0" parMax="pi/4" labelPosition="right">
          (3/8 cos(t), 3/8 sin(t))
      </curve>
      <label anchor="(7/16, 3/16)"><m>\large$var</m></label>
      <label hide="$ansA.creditAchieved" anchor="(2.15, 1)"><m>\Large a</m></label>
      <label hide="$ansB.creditAchieved" anchor="(1.2, -0.2)"><m>\Large b</m></label>
      <label hide="$ansC.creditAchieved" anchor="(.95, 1.2)"><m>\Large c</m></label>
      <label hide="not($ansA.creditAchieved)" anchor="(2.15, 1)"><m>\Large x</m></label>
      <label hide="not($ansB.creditAchieved)" anchor="(1.2, -0.2)"><m>\Large \sqrt{3^2-x^2}</m></label>
      <label hide="not($ansC.creditAchieved)" anchor="(.95, 1.2)"><m>\Large 3</m></label>
    </graph>
  <answer name="ansA">
    <mathInput>
      <label>
        <m>a = </m>
      </label>
    </mathInput>
    <award><m>x</m></award>
  </answer><br/>
  <answer name="ansB">
    <mathInput>
      <label>
        <m>b = </m>
      </label>
    </mathInput>
    <award><m>\sqrt{9-x^2}</m></award>
  </answer><br/>
  <answer name="ansC">
    <mathInput>
      <label>
        <m>c = </m>
      </label>
    </mathInput>
    <award><m>3</m></award>
  </answer><br/>
    </div>
  <div>
    <answer>
      <mathInput>
        <label>
          Thus, the final answer in terms of <m>x</m> is
        </label>
      </mathInput>
      <award>
        <m>-\frac{\sqrt{9-x^2}}{x}-\arcsin \frac{x}{3} +C</m>
      </award>
    </answer>.
  </div>
</cascade>