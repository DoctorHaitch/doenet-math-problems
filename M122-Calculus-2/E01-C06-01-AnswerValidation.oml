<!--
  Author: Kris Hollingsworth
  Class: Math122-Calculus 2
  Original Date: 5/24/26
  Revised Date: 5/30/26 (Improved Formatting)
  File: E01-C06-01-AnswerValidation.oml
  Description:
    Some progress checks on an ODE word problem.
  Raw Link: https://raw.githubusercontent.com/DoctorHaitch/doenet-math-problems/main/M122-Calculus-2/E01-C06-01-AnswerValidation.oml
-->
<setup>
  <module name="EqnFeedbackGenerator">
    <moduleAttributes>
      <math name="ans" />
    </moduleAttributes>
    <setup>
      <boolean name="answerIsExpression">
        not(<matchesPattern pattern="＿=＿">$ans</matchesPattern>) and
        <matchesPattern pattern="()">$ans</matchesPattern>
      </boolean>
    </setup>
    <feedback condition="$answerIsExpression">
      It seems you've entered an expression. Looking back at the definition of a
      differential equation, it should be a <em>function</em>, which by definition
      is a relationship between indepedent and dependent variables.
    </feedback>
  </module>
</setup>

<cascade>
  <section>
    <title>Define your notation:</title>
    <p>
      <mathInput name="depVar"><label>Dependent Variable:</label></mathInput>
      <br />
      <mathInput name="indVar"><label>Independent Variable:</label></mathInput>
      <br />
    </p>

    <alert>Write down each of the following:</alert>
    <p>
      <answer name="ansDiffEq">
        <mathInput functionSymbols="$depVar">
          <label>The differential equation that models this problem:</label>
        </mathInput>
        <award>
          <m>\frac{d$depVar}{d$indVar} = \frac{2*(3-$depVar)}{25}</m>
        </award>
        <award><m>$depVar' = \frac{2*(3-$depVar)}{25}</m></award>
        <award>
          <math format="latex" referencesAreFunctionSymbols="$depVar">
            $depVar'($indVar) = \frac{2*(3-$depVar($indVar))}{25}
          </math>
        </award>
        <award>
          <math format="latex" referencesAreFunctionSymbols="$depVar">
            \frac{d$depVar}{d$indVar} = \frac{2*(3-$depVar($indVar))}{25}
          </math>
        </award>
      </answer>
    </p>
    <module copy="$EqnFeedbackGenerator" ans="$ansDiffEq" />
  </section>

  <section>
    <title />
    <p>
      <answer name="genSoln">
        <mathInput functionSymbols="$depVar">
          <label>The general solution of this differential equation:</label>
        </mathInput>
        <award><m>$depVar = Ce^{\frac{-2$indVar}{25}}+3</m></award>
        <award>
          <math format="latex" referencesAreFunctionSymbols="$depVar">
            $depVar($indVar) = Ce^{\frac{-2$indVar}{25}}+3
          </math>
        </award>
      </answer>
    </p>
    <module copy="$EqnFeedbackGenerator" ans="$genSoln" />
  </section>

  <section>
    <title />
    <p>
      <answer name="partSoln">
        <mathInput functionSymbols="$depVar">
          <label>The particular solution of this differential equation:</label>
        </mathInput>
        <shortDescription>Enter particular solution.</shortDescription>
        <award><m>$depVar = 57e^{\frac{-2$indVar}{25}}+3</m></award>
        <award>
          <m>\frac{d$depVar}{d$indVar} = 57e^{\frac{-2$indVar}{25}}+3</m>
        </award>
        <award>
          <math format="latex" referencesAreFunctionSymbols="$depVar">
            $depVar($indVar) = 57e^{\frac{-2$indVar}{25}}+3
          </math>
        </award>
      </answer>
    </p>
    <module copy="$EqnFeedbackGenerator" ans="$partSoln" />
  </section>

  <section>
    <title />
    <p>
      <answer name="finalAns">
        <mathInput functionSymbols="$depVar">
          <label>The answer to the original question:</label>
        </mathInput>
        <award><m>57e^{\frac{-2*90}{25}}+3</m></award>
        <award>
          <math format="latex" referencesAreFunctionSymbols="$depVar">
            $depVar(90)=57e^{\frac{-2(90)}{25}}+3
          </math>
        </award>
      </answer>
    </p>
    <feedback condition="$finalAns.creditAchieved">
      <p>
        This is a good answer for an automated system, but in your written work,
        the answer to a word problem should be a <em>sentence</em>!
      </p>
      <p>
        For example:<br /> "The amount of salt in the tank after 90 minutes is <m>
          \left(57 e^{-\frac{36}{5}}+3\right)
        </m> kilograms."
      </p>
      <p>
        If you feel it necessary to round, indicate you have done so, but also
        give the precise answer, for example:<br /> "The amount of salt in the tank
        after 90 minutes is <m>\left(57 e^{-\frac{36}{5}}+3\right)</m> kilograms,
        or approximately 3.0426 kilograms."
      </p>
      <p>
        You'll worry more about <em>significant digits</em> and how many digits
        to include in answers in your applied coursework.
      </p>
    </feedback>
  </section>
</cascade>