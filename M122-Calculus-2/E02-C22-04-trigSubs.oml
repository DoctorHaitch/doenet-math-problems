<!--
  Author: Kris Hollingsworth
  Class: Math122-Calculus 2
  Date: 6/14/26
  File: E02-C22-04-trigSubs.oml
  Description:
    Scaffolded derivation of the Integration by Parts identity.
  Raw Link: https://raw.githubusercontent.com/DoctorHaitch/doenet-math-problems/main/M122-Calculus-2/E02-C22-04-trigSubs.oml
-->
<table name="table1">
  <title></title>
  <tabular left="minor" right="minor" top="minor" bottom="minor">
    <row header>
      <cell>Expression</cell>
      <cell colSpan="3">Substitution</cell>
      <cell colSpan="2">Identity</cell>
    </row>
    <row>
      <cell><m>a^2-x^2</m></cell>
      <cell colSpan="3" halign="right">
        <answer>
          <mathInput><label>x=</label></mathInput><award><m>a\sin t</m></award>
        </answer>, with <m>\frac{-\pi}{2}\leq t \leq \frac{\pi}{2}</m>
      </cell>
      <cell colSpan="2"><m>1-\sin^2t = \cos^2t</m></cell>
    </row>
    <row>
      <cell><m>a^2+x^2</m></cell>
      <cell colSpan="3" halign="right">
        <answer>
          <mathInput><label>x=</label></mathInput><award><m>a\tan t</m></award>
        </answer>, with <m>\frac{-\pi}{2} < t < \frac{\pi}{2}</m>
      </cell>
      <cell colSpan="2"><m>1+\tan^2t = \sec^2t</m></cell>
    </row>
    <row>
      <cell><m>x^2-a^2</m></cell>
      <cell colSpan="3" halign="right">
        <answer>
          <mathInput><label>x=</label></mathInput><award><m>a\sec t</m></award>
        </answer>, with <m>0 \leq t < \frac{\pi}{2}</m> <br />or <m>\pi \leq t < \frac{3\pi}{2}</m>
      </cell>
      <cell colSpan="2"><m>1+\tan^2t = \sec^2t</m></cell>
    </row>
  </tabular>
</table>