<!--
  Author: Kris Hollingsworth
  Class: Math122-Calculus 2
  Date: 5/23/26
  File: E01-C13-01-CubicRotationDisc.oml
  Description:
    Visualize regioned of cubic polynomial rotations
    using horizontal slices.
  Raw Link: https://raw.githubusercontent.com/DoctorHaitch/doenet-math-problems/main/M122-Calculus-2/E01-C13-01-CubicRotationDisc.oml
-->

<setup>
  <styleDefinition
    styleNumber="1"
    lineColor="#2E86C1"
    lineOpacity=".85"
    fillColor="#2E86C1"
    fillColorWord="Blue"
  />
  <styleDefinition
    styleNumber="2"
    lineColor="#CB4335"
    lineOpacity=".75"
    fillColor="#CB4335"
    fillColorWord="Vermillion"
  />
  <styleDefinition
    styleNumber="3"
    lineColor="#3C7FA6"
    lineOpacity=".8"
    fillColor="#5499C7"
    fillOpacity=".1"
    fillColorWord="Sky Blue"
  />
  <styleDefinition
    styleNumber="4"
    lineColor="#8E44AD"
    fillColor="#8E44AD"
    fillOpacity="1"
    fillColorWord="Reddish Purple"
  />

  <styleDefinition
    styleNumber="10"
    lineColor="#243746"
    fillColor="#243746"
    fillOpacity=".8"
    fillColorWord="Dark Gray"
    lineWidth="3"
  />
  <styleDefinition
    styleNumber="11"
    lineColor="#243746"
    fillColor="#243746"
    fillOpacity="1"
    lineStyle="dashed"
    fillColorWord="Dark Gray"
    lineWidth="5"
  />
  <styleDefinition
    styleNumber="12"
    lineColor="#243746"
    fillColor="#243746"
    fillOpacity="1"
    lineStyle="solid"
    fillColorWord="Dark Gray"
    lineWidth="10"
  />

  <styleDefinition
    styleNumber="19"
    lineColor="#8A6F08"
    lineOpacity=".74"
    fillColor="#B7950B"
    fillColorWord="Mustard"
  />
  <styleDefinition
    styleNumber="17"
    lineColor="#2E8B78"
    lineOpacity=".81"
    fillColor="#45B39D"
    fillColorWord="Blueish Green"
  />
  <styleDefinition
    styleNumber="16"
    lineColor="#9A7D0A"
    lineOpacity=".85"
    fillColor="#D4AC0D"
    fillColorWord="Yellow"
  />

  <function name="f" domain="[0,2]">2x^2-x^3</function>
  <function name="z" domain="[0,2]">0</function>
  <number name="k">2^(1/3)</number>
  <math name="B">sqrt(-32y+27y^2)</math>
  <math name="C">16-27y+3*sqrt(3)*$B</math>
  <math name="A">$C^(1/3)</math>

  <group name="rightPointGroup">
    <math name="rpExpr">(1/3)*(2+(4*$k)/$A+$A/$k)</math>
    <function name="rightPoint" variable="y" displayDecimals="2">
      re($rpExpr)
    </function>
  </group>

  <group name="leftPointGroup">
    <math name="lpExpr">
      2/3-(2*$k*(1-i*sqrt(3)))/(3*$A)-((1+i*sqrt(3))*$A)/(6*$k)
    </math>
    <function name="leftPoint" variable="y" displayDecimals="2">
      re($lpExpr)
    </function>
  </group>
</setup>

<!-- ACTIVITY -->

<graph name="cubic" xMin="-3" xMax="3" yMin="-1" yMax="2">
  <shortDescription>
    Plot of y=2x^2-x^3 with some manipulatives.
  </shortDescription>
  <regionBetweenCurves boundaryValues="0 2">$f $z</regionBetweenCurves>
  <label
    anchor="($cubic.xMax-.2, $cubic.yMax-.1)"
    positionFromAnchor="lowerLeft"
  >
    <m>\Large y= 2x^2-x^3</m>
  </label>