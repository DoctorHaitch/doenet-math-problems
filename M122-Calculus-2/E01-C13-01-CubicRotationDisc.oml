<!--
  Author: Kris Hollingsworth
  Class: Math122-Calculus 2
  Date: 5/23/26
  File: E01-C13-01-CubicRotationDisc.oml
  Description:
    Visualize regioned of cubic polynomial rotations
    using horizontal slices.
  Raw Link: https://raw.githubusercontent.com/DoctorHaitch/doenet-math-problems/main/M122-Calculus-2/E01-C13-01-CubicRotationDisc.oml
-->

<setup>
  <number name="reflection">3</number>
  <styleDefinition styleNumber="1"
    lineColor="#2E86C1"
    lineOpacity=".85"
    fillColor="#2E86C1"
    fillColorWord="Blue" />
  <styleDefinition styleNumber="2"
    lineColor="#CB4335"
    lineOpacity=".75"
    fillColor="#CB4335"
    fillColorWord="Vermillion" />
  <styleDefinition styleNumber="3"
    lineColor="#3C7FA6"
    lineOpacity=".8"
    fillColor="#5499C7"
    fillOpacity=".1"
    fillColorWord="Sky Blue" />
  <styleDefinition styleNumber="4"
    lineColor="#8E44AD"
    fillColor="#8E44AD"
    fillOpacity="1"
    fillColorWord="Reddish Purple" />
  
  <styleDefinition styleNumber="10"
    lineColor="#243746"
    fillColor="#243746"
    fillOpacity=".8"
    fillColorWord="Dark Gray"
    lineWidth="3" />
  <styleDefinition styleNumber="11"
    lineColor="#243746"
    fillColor="#243746"
    fillOpacity="1"
    lineStyle="dashed"
    fillColorWord="Dark Gray"
    lineWidth="5" />
  <styleDefinition styleNumber="12"
    lineColor="#243746"
    fillColor="#243746"
    fillOpacity="1"
    lineStyle="solid"
    fillColorWord="Dark Gray"
    lineWidth="10" />
  
  <styleDefinition styleNumber="19"
    lineColor="#8A6F08"
    lineOpacity=".74"
    fillColor="#B7950B"
    fillColorWord="Mustard" />
  <styleDefinition styleNumber="17"
    lineColor="#2E8B78"
    lineOpacity=".81"
    fillColor="#45B39D"
    fillColorWord="Blueish Green" />
  <styleDefinition styleNumber="16"
    lineColor="#9A7D0A"
    lineOpacity=".85"
    fillColor="#D4AC0D"
    fillColorWord="Yellow" />

  <function name="f" domain="[0,2]">2x^2-x^3</function>
  <function name="z" domain="[0,2]">0</function>
  <number name="k">2^(1/3)</number>
  <math name="B">sqrt(-32y+27y^2)</math>
  <math name="C">16-27y+3*sqrt(3)*$B</math>
  <math name="A">$C^(1/3)</math>
  
  <group name="rightPointGroup">
    <math name="rpExpr">(1/3)*(2+(4*$k)/$A+$A/$k)</math>
    <function  name="rightPoint" variable="y" displayDecimals="2">re($rpExpr)</function>
  </group>

  <group name="leftPointGroup">
    <math name="lpExpr">2/3-(2*$k*(1-i*sqrt(3)))/(3*$A)-((1+i*sqrt(3))*$A)/(6*$k)</math>
    <function name="leftPoint" variable="y" displayDecimals="2">
      re($lpExpr)
    </function>
  </group>
</setup>

<!-- ACTIVITY -->

<graph name="cubic" xMin="-3" xMax="3" yMin="-1" yMax="2">
  <shortDescription>Hover fuck off.</shortDescription>
  <regionBetweenCurves boundaryValues="0 2">$f $z</regionBetweenCurves>
  <label anchor="($cubic.xMax-.2, $cubic.yMax-.1)" positionFromAnchor="lowerLeft"><m>\Large y= 2x^2-x^3</m></label>
  <!------------------------------------
  <!------------------ AXIS OF ROTATION
  <!----------------------------------->
  <group name="rotation" hide="not($showAxis)">
    <setup> <!-- Precompute values for efficiency -->
      <!-- Width for vector head seems to depend on view-window.
           Mostly trying to make smallest values with arrow head appearing. -->
      <number name="width">0.3</number> 
      <number name="shift">0.5</number>
      <number name="a1">3*pi/4 + $width</number>
      <number name="a2">3*pi/4 - $width</number>
      <number name="c1">cos($a1)</number>
      <number name="s1">sin($a1)</number>
      <number name="c2">cos($a2)</number>
      <number name="s2">sin($a2)</number>
      <point name="v1">($c1/3, $s1/12 - $shift)</point>
      <point name="v2">($c2/3, $s2/12 - $shift)</point>
    </setup>
    <vector styleNumber="10" tail="$v1" head="$v2" />
    <curve styleNumber="10"
      name="parameterizedEllipse" 
      variable="t" parMin="3/4 pi" parMax="9/4 pi">
      (1/3*cos(t), 1/12*sin(t)-$shift)
    </curve>
    <lineSegment styleNumber="11" endpoints="(0,-1) (0,2)" />
  </group>

  <group name="reflection" hide="not($showReflection)">
    <setup>
      <function name="g" styleNumber="3">$$f(-x)</function>
    </setup>
    <regionBetweenCurves styleNumber="3" boundaryValues="-2 0">$g $z</regionBetweenCurves>
  </group>
  
  <group name="slice2d" hide="not($show2D)">
    <setup> <!-- Precompute values for efficiency -->
      <number name="rightVal">$$rightPoint($slide)</number>
      <number name="leftVal">$$leftPoint($slide)</number>
    </setup>
    <rectangle
      styleNumber="4"
      vertices="($rightVal,$slide) ($leftVal,$slide+0.05)"
      filled
    />
  </group>

  <group name="slice3dGroup" hide="not($show3D)">  
    <!-- cheap perspective factor -->
    <number hide name="l">1 - 0.3*$slide</number>     <!-- vertical flatten -->

    <!-- sparse spokes -->
    <repeatForSequence from="0" to="2pi" step="pi/3" valueName="v">
      <setup>
        <number name="cv">cos($v)</number>
        <number name="sv">sin($v)</number>
      </setup>
      <lineSegment
        styleNumber="12"
        endpoints="
          ($rightVal*$cv, (1/6)*$l*$sv + $slide + 0.025)
          ($leftVal*$cv, (1/15)*$l*$sv + $slide + 0.025)
        "
      />
    </repeatForSequence>
  
    <!-- outer ellipse -->
    <curve styleNumber="12" variable="t" parMin="0" parMax="2pi">
      ($rightVal*cos(t), (1/6)*$l*sin(t) + $slide + 0.025)
    </curve>
  
    <!-- inner ellipse -->
    <curve styleNumber="12" variable="t" parMin="0" parMax="2pi">
      ($leftVal*cos(t), (1/15)*$l*sin(t) + $slide + 0.025)
    </curve>
  </group>
</graph>

<booleanInput name="showAxis" prefill="true">
  <label>Show axis of rotation.</label>
</booleanInput><br />
<booleanInput name="show2D">
  <label>Show 2D slice</label>
</booleanInput><br />
<booleanInput name="showReflection">
  <label>Show Reflection across Axis</label>
</booleanInput><br />
<booleanInput name="show3D">
  <label>Show 3D slice</label>
</booleanInput><br />
<boolean hide name="test">$show2D or $show3D</boolean>
<slider hide="not($test)" name="slide" initialValue=".3" from="0" to="32/27" step=".05" showTicks="false" showValue="false">
  <label>[<m>y</m>-Value of representative slice]</label>
</slider>