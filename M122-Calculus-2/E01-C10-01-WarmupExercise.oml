<!-- %%%%%%%%%%%%%%%%%%%%%%%%%%%%
     %%%%%%%%%%% Common Variables
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->
<setup>
  <number name="a">2</number>
  <number name="b">7</number>
  <number name="MutedGreen">117733</number>
  <styleDefinition name="MGreenStyle" styleNumber="10" lineWidth="3" lineStyle="solid" lineColor="#$MutedGreen"  fillColor="#$MutedGreen" />
  <number name="MutedIndigo">332288</number>
  <function name="f" styleNumber="10" domain="[2,7]">1.5*sin(x)+4</function>
  <function name="g" styleNumber="9" domain="[2,7]">1/3*cos(x)+7</function>
  <function styleNumber="10" name="z" domain="[2,7]">0</function>
</setup>
<!-- %%%%%%%%%%%%%%%%%%%%%%%%%%%%
     %%%%%%%%%%%%%%%%% First Plot
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->
<exercise noAutoTitle>
<graph fixAxes width="80%" showBorder="false" aspectRatio="1.75" grid="true" xmin="1" xmax="8" displayXAxisTickLabels="false" ymin="-1" ymax="8" showNavigation="false" decorative>
  <shortDescription>A function f(x) between x=a and x=b with the area between f(x) and the x-axis shaded in green.</shortDescription>
  <lineSegment styleNumber="10" fixLocation endpoints="($a,$$f($a)) ($a,0)" />  
  <lineSegment styleNumber="10" fixLocation endpoints="(7,$$f(7)) (7,0)" labelIsName />
  <label positionFromAnchor="right" anchor="($a,-0.5)" fixLocation><m>\huge a</m></label>
  <label anchor="($b,-0.5)" fixLocation><m>\huge b</m></label>
 <label fixLocation anchor="(($a+$b)/1.9,3.25)"><m>\huge f(x)</m></label>
  <regionBetweenCurves hide="false" styleNumber="10" boundaryValues="2 7">$f $z</regionBetweenCurves>
</graph>
<p>
  Write an expression that represents the green shaded area: 
  <answer>
    <shortDescription>Write an expression that represents the green shaded area:</shortDescription>
    <m>\int_a^b f(x) dx</m>
  </answer>
</p>
</exercise>

<!-- %%%%%%%%%%%%%%%%%%%%%%%%%%%%
     %%%%%%%%%%%%%%%% Second Plot
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->
<exercise noAutoTitle>
<graph fixAxes width="80%" showBorder="false" aspectRatio="1.75" grid="true" xmin="1" xmax="8" displayXAxisTickLabels="false" ymin="-1" ymax="8" showNavigation="false" decorative>
  <shortDescription>A function g(x) between x=a and x=b with the area between g(x) and the x-axis shaded in indigo.</shortDescription>
  <lineSegment styleNumber="9" fixLocation endpoints="($a,$$g($a)) ($a,0)" />  
  <lineSegment styleNumber="9" fixLocation endpoints="(7,$$g(7)) (7,0)" labelIsName />
  <label positionFromAnchor="right" anchor="($a,-0.5)" fixLocation><m>\huge a</m></label>
  <label anchor="($b,-0.5)" fixLocation><m>\huge b</m></label>
 <label fixLocation anchor="($a+0.5,$$g($a)+0.5)"><m>\huge g(x)</m></label>
  <regionBetweenCurves hide="false" styleNumber="9" boundaryValues="2 7">$g $z</regionBetweenCurves>
</graph>
<p>
  Write an expression that represents the indigo shaded area: 
  <answer>
    <shortDescription>Write an expression that represents the indigo shaded area:</shortDescription>
    <m>\int_a^b g(x) dx</m>
  </answer>
</p>
</exercise>

<!-- %%%%%%%%%%%%%%%%%%%%%%%%%%%%
     %%%%%%%%%%%%%%%%% Third Plot
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% -->
<exercise noAutoTitle>
<graph fixAxes width="80%" showBorder="false" aspectRatio="1.75" grid="true" xmin="1" xmax="8" displayXAxisTickLabels="false" ymin="-1" ymax="8" showNavigation="false" decorative>
  <shortDescription>Both functions f(x) and g(x) between x=a and x=b with the area between f(x) and the x-axis shaded in green and the area between g(x) and the x-axis shaded in indigo.</shortDescription>
  <lineSegment styleNumber="9" fixLocation endpoints="($a,$$g($a)) ($a,0)" />  
  <lineSegment styleNumber="9" fixLocation endpoints="(7,$$g(7)) (7,0)" labelIsName />
  <label positionFromAnchor="right" anchor="($a,-0.5)" fixLocation><m>\huge a</m></label>
  <label anchor="($b,-0.5)" fixLocation><m>\huge b</m></label>
  <label fixLocation anchor="(($a+$b)/1.9,3.25)"><m>\huge f(x)</m></label>
 <label fixLocation anchor="($a+0.5,$$g($a)+0.5)"><m>\huge g(x)</m></label>
  <regionBetweenCurves hide="false" styleNumber="9" boundaryValues="2 7">$g $z</regionBetweenCurves>
  <regionBetweenCurves hide="false" styleNumber="10" boundaryValues="2 7">$f $z</regionBetweenCurves>
</graph>
<p>
  Write a mathematical expression which calculates the area which is indigo, but not green.
  <answer>
    <shortDescription>Write an expression that represents the area which is indigo but not green:</shortDescription>
    <award><m>\int_a^b f(x)-\int_a^b g(x) dx</m></award>
    <award><m>\int_{a}^{b} f\left(x\right)dx - \int_{a}^{b} g\left(x\right)dx</m></award>
    <award credit="0" name="combinedNoParens"><m>\int_a^b f(x)-g(x) dx</m></award>
    <award name="combined">
      <m>\int_a^b (f(x)-g(x)) dx</m>
    </award>
  </answer>
</p>
<feedback condition="$combinedNoParens">
  <p>
    Note, from the definition of integration
    <me>
      {\int_a}^{b} f(x)-g(x) dx
      = \lim_{n\to\infty} \sum_{i=1}^n f(x_i)-g(x_i) \Delta x,
    </me>
    which is close, but not quite the correct integral!
  </p>
</feedback>
<feedback condition="$combined">
  <p>
    While your answer is correct, it is not quite in the form we would expect based on the questions:
    <me>{\int_a}^{b} f(x)\;dx - {\int_a}^{b} g(x) dx.</me>
    Make sure you know why your answer is equivalent to this one!
  </p>
</feedback>
</exercise>
